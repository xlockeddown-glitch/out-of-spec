; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Out of Spec"
config/description="Chunky voxel life-sim: satellite-linked remote farming/mining, tarantula terrariums, satirical metrology."
run/main_scene="res://scenes/main_farm.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

DataManager="*res://scripts/autoload/DataManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

rover_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
rover_reverse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
rover_steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
rover_steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
rover_till={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
rover_zero_steering={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="rover"
3d_physics/layer_3="signal_occluder"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
